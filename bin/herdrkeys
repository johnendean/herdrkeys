#!/bin/sh
# Run herdrkeys from a checkout or an installed plugin, with no venv and no
# install step: the daemon has no third-party dependencies, so any python3 new
# enough is all it needs.
#
# "New enough" is 3.11, for tomllib, and the first python3 on PATH may not be:
# launchd's bare PATH finds the Command Line Tools' 3.9, and the daemon died at
# import every ten seconds. So each candidate is asked, and Homebrew's usual
# places are tried after PATH.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

extra=${HERDRKEYS_PYTHON_DIRS-/opt/homebrew/bin /usr/local/bin}
for dir in $extra; do
    PATH="$PATH:$dir"
done

for name in python3 python3.14 python3.13 python3.12 python3.11; do
    for candidate in $(which -a "$name" 2>/dev/null); do
        if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            exec "$candidate" -m herdrkeys "$@"
        fi
    done
done

echo "herdrkeys: needs Python 3.11 or newer, and found none (PATH=$PATH)" >&2
exit 1
