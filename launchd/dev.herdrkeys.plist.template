<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.herdrkeys</string>

  <!-- The wrapper finds its own root and uses the system python3. herdrkeys has
       no third-party dependencies, so there is no venv to point at and nothing
       for a Homebrew upgrade to break. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/bin/herdrkeys</string>
    <string>run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- A crash net only. The daemon reconnects to Herdr and to the keypad on its
       own and never exits voluntarily, so launchd should rarely have to act. -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StandardOutPath</key>
  <string>__REPO__/herdrkeys.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/herdrkeys.log</string>
</dict>
</plist>
